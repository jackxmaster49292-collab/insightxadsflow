# --- Production (docker-compose.prod.yml) -----------------------------------
# Domain Caddy will get an HTTPS certificate for. Required in production —
# Telegram only accepts https:// for the Mini App button.
PANEL_DOMAIN=
# Strong password for Postgres. The base compose file threads this into both the
# database server and the app's connection string.
POSTGRES_PASSWORD=

# --- Core -------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://insight:insight@localhost:5433/insight
REDIS_URL=redis://localhost:6380/0
APP_SECRET_KEY=change-me-to-a-long-random-string
PANEL_ORIGIN=http://localhost:8080
ENVIRONMENT=local
COOKIE_SECURE=false

# --- Envelope encryption ----------------------------------------------------
# Base64 of 32 random bytes. Generate with:
#   python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
#
# This key never goes in the database and must never be included in a database
# backup — a backup alone must not be enough to decrypt Telegram sessions.
ENCRYPTION_KEK=MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMD0=
ENCRYPTION_KEK_VERSION=1

# --- Telegram control panel (bot + Mini App) --------------------------------
# A SEPARATE bot from any forwarding bot. Telegram allows only one getUpdates
# consumer per token, so sharing one makes the two fight (409 Conflict).
# Create it with @BotFather.
ADMIN_BOT_TOKEN=

# Comma-separated numeric Telegram user IDs allowed to use the panel.
# Ask @userinfobot for yours. EMPTY MEANS NOBODY — the panel fails closed, so a
# misconfigured deploy is locked rather than open to everyone.
ADMIN_TELEGRAM_IDS=

# HTTPS origin serving the Mini App. Telegram only accepts https:// for a
# web_app button, so with anything else the "full panel" button is hidden.
# This is where bot tokens, phone numbers and 2FA passwords are entered — over
# HTTPS, never typed into a Telegram chat.
MINIAPP_URL=

# --- Telegram ---------------------------------------------------------------
# "mock" (default) never contacts Telegram. Set "live" only when you intend to.
# NEVER set live in a test or CI configuration.
TELEGRAM_PROVIDER=mock

# Required only for MTProto user-account connections. Get them from
# https://my.telegram.org
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=

# --- Operational safety controls (not monetization limits) ------------------
WORKER_CONCURRENCY=8
PER_CONNECTION_INFLIGHT=2
ALBUM_BUFFER_MS=2000
BOT_POLL_TIMEOUT_S=25
SAFETY_PAUSE_THRESHOLD=5
MAX_ATTEMPTS=5
FLOOD_WAIT_PAUSE_THRESHOLD_S=300
LEASE_SECONDS=120
EVENT_RETENTION_DAYS=90

# --- Optional ---------------------------------------------------------------
# SENTRY_DSN=
